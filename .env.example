# ─── Database ──────────────────────────────────────
DATABASE_URL=postgresql://businesspulse:businesspulse@localhost:5432/businesspulse
REDIS_URL=redis://localhost:6379

# ─── Auth ──────────────────────────────────────────
JWT_SECRET=your-jwt-secret-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-this-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── OpenAI ────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key

# ─── Twilio (SMS OTP) ─────────────────────────────
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ─── Email (SendGrid) ─────────────────────────────
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@businesspulse.ai

# ─── AWS S3 ────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=businesspulse-uploads
AWS_REGION=ap-south-1

# ─── App ───────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000

# ─── Next.js Public ───────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_APP_NAME=BusinessPulse AI
